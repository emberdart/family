# name: Haskell Release Dev
on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

permissions:
  contents: write

jobs:
  build:

    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        include:
          - os: ubuntu-latest
            exeName: family-dev-linux-x86_64
          - os: macOS-latest
            exeName: family-dev-darwin-aarch64
          # configure: error: cannot guess build type; you must specify one
          # - os: windows-latest
          #   exeName: family-dev-windows-x86_64.
    env:
      CONFIG: "--enable-tests --enable-benchmarks"
    steps:
    - uses: actions/checkout@v4
    - uses: haskell-actions/setup@v2
      with:
        ghc-version: '9.14.1'
        cabal-version: '3.16.1.0'
    - run: cabal update
    - run: cabal v2-freeze $CONFIG
    - name: Cache
      uses: actions/cache@v3
      with:
        path: |
          ${{ steps.setup-haskell-cabal.outputs.cabal-store }}
          dist-newstyle
        key: ${{ runner.os }}-${{ matrix.ghc }}-${{ hashFiles('cabal.project.freeze') }}
        restore-keys: |
          ${{ runner.os }}-${{ matrix.ghc }}-
    - name: Build
      run: cabal new-build $CONFIG all
    - name: Run tests
      run: cabal test all
    - name: Get executable path
      id: get-path
      run: echo "path=$(cabal list-bin family)" >> $GITHUB_OUTPUT
      shell: bash
    - name: Upload binaries to release
      uses: svenstaro/upload-release-action@v2
      with:
        repo_token: ${{ secrets.GITHUB_TOKEN }}
        file: ${{ steps.get-path.outputs.path }}
        asset_name: ${{ matrix.exeName }}
        tag: latest
        overwrite: true
        prerelease: true